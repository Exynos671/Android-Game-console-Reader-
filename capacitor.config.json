{
  "appId": "com.handheld.reader",
  "appName": "掌上阅读器 Handheld Reader",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SystemBars": {
      "hidden": true,
      "insetsHandling": "css",
      "style": "DARK"
    }
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
